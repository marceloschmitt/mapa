# Copie este arquivo para .env e ajuste conforme o ambiente:
#   cp .env.example .env

# SQLite (criado automaticamente na primeira execução se a pasta/arquivo não existirem)
DB_PATH=data/mapa.db

# Python usado pelos botões da web (Gerar passe livre, Gerar análise de perda de vaga).
# Vazio = /usr/bin/python3 ou /usr/local/bin/python3. No macOS, informe o Python
# instalado (ex.: /usr/local/bin/python3): /usr/bin/python3 é só um atalho do Xcode.
# PYTHON_BIN=

# false = nenhum e-mail sai (desenvolvimento). Em produção use true.
EMAIL_SEND=false

# Periodicidade dos avisos ao staff (America/Sao_Paulo).
# Use "todos" para qualquer dia. Alunos não têm dia fixo (máx. 1 a cada 7 dias).
EMAIL_ALARMES_DIA_STAFF=quarta

# Piloto staff (opcional): se preenchido, só este e-mail recebe avisos
# a professores/coordenadores (filtrado pelas disciplinas/cursos dele).
# Deixe vazio ou comente a linha para avisar toda a equipe.
# EMAIL_ALARMES_STAFF_APENAS=

# API SIGAA (opcional). O que estiver preenchido aqui vale mais que a tela
# Configurações → API: o campo aparece só para leitura e os scripts Python usam
# o mesmo valor. Deixe vazio (ou comentado) para configurar pela tela.
# O Client Secret do .env nunca é gravado no banco nem mostrado na tela.
# Período letivo e datas da coleta continuam só na tela (mudam todo semestre).
# API_OAUTH_URL=https://api.exemplo.edu.br/oauth/token
# API_CLIENT_ID=
# API_CLIENT_SECRET=
# API_URL_MATRICULADOS=
# API_URL_ALUNOS=https://api.exemplo.edu.br/.../alunos?login={login}
# API_URL_ALUNOS_MASSA_CADASTRO=
# API_URL_ALUNOS_MASSA_INTERVALO=https://api.exemplo.edu.br/...?data_inicial={data_inicial}&data_final={data_final}
# API_VERIFY_SSL=true