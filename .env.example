# Copie este arquivo para .env e ajuste conforme o ambiente:
#   cp .env.example .env

# SQLite (criado automaticamente na primeira execução se a pasta/arquivo não existirem)
DB_PATH=data/mapa.db

# false = nenhum e-mail sai (desenvolvimento). Em produção use true.
EMAIL_SEND=false

# Periodicidade dos avisos ao staff (America/Sao_Paulo).
# Use "todos" para qualquer dia. Alunos não têm dia fixo (máx. 1 a cada 7 dias).
EMAIL_ALARMES_DIA_STAFF=quarta

# Piloto staff (opcional): se preenchido, só este e-mail recebe avisos
# a professores/coordenadores (filtrado pelas disciplinas/cursos dele).
# Deixe vazio ou comente a linha para avisar toda a equipe.
# EMAIL_ALARMES_STAFF_APENAS=
